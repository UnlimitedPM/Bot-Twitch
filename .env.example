# ---------------------------------------------------------------------------
# Configuration du bot Twitch (copier ce fichier en ".env" puis remplir)
# ---------------------------------------------------------------------------

# Identifiants de ton application Twitch (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Pseudo du streamer a surveiller (sans @)
STREAMER_LOGIN=astherinae

# Message envoye au tout debut du live (une seule fois par live)
GREETING=Salut Asther ^^
GREETING_ENABLED=true
# Age maximum (minutes) du live pour envoyer ce message : evite de dire bonjour
# si le bot redemarre au milieu d'un live. 0 = toujours.
GREETING_MAX_AGE_MINUTES=5

# Qualite regardee pour maintenir la vue ouverte (audio_only = tres leger)
WATCH_QUALITY=audio_only

# Intervalle (secondes) du filet de securite qui verifie le live en plus d'EventSub
POLL_INTERVAL=20

# Logs : INFO ou DEBUG
LOG_LEVEL=INFO

# Fuseau horaire des horodatages de logs. Un conteneur Docker est en UTC par
# defaut, d'ou un decalage de deux heures pour la France. Ex. : Europe/Paris
TZ=Europe/Paris

# Optionnel : webhook Discord pour les notifications (laisser vide = desactive)
DISCORD_WEBHOOK=

# Optionnel : token de secours si tu ne veux pas utiliser data/token.json
# (normalement rempli automatiquement par "python get_token.py")
#TWITCH_REFRESH_TOKEN=
